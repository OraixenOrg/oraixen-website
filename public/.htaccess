# Oraixen website — three-market SPA routing + static SEO shells.
#
# Public URL spaces:
#   /en/*      English
#   /ar-eg/*   Arabic — Egypt
#   /ar-sa/*   Arabic — Saudi Arabia
#
# The ten static routes in each market (eight core pages plus two solution
# pages) are served a generated HTML shell that
# already carries that market's <title>/description/canonical/hreflang/OG tags
# (see scripts/generate-static-seo.mjs), so crawlers and link previews are
# correct before React runs. Those rewrites are INTERNAL — the visible URL stays
# /ar-sa/about. Dynamic routes such as /en/projects/:slug use the SPA fallback.
#
# Locale-less URLs are handed to market-router.php, which picks a market from
# country + saved preference + Accept-Language and 302s to the same page there.

# Hostinger's mod_geoip, verified working on this production host: it exposes
# GEOIP_COUNTRY_CODE to PHP from the connecting address. Deliberately not
# wrapped in <IfModule>: Hostinger publishes no module identifier, and a wrong
# guess would silently disable country detection and route everyone to English.
GeoIPEnable On

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. The generated shells must not be reachable as their own public URLs, or
  #    they would be a second indexable copy of every page. THE_REQUEST holds
  #    the ORIGINAL request line, so this matches a browser asking for
  #    /__seo/en/about.html while leaving Apache's internal rewrites alone.
  RewriteCond %{THE_REQUEST} \s/+__seo/ [NC]
  RewriteRule ^ - [R=404,L]

  # 2. The bare root must be handled BEFORE the real-file rule below, because
  #    the document root is itself a real directory and would otherwise be
  #    served by DirectoryIndex instead of reaching the router.
  RewriteRule ^$ market-router.php [L]

  # 3. Real files and folders win before any localization — /contact.php,
  #    /market-router.php, /market-context.php, /assets/*, /flags/*,
  #    /sitemap.xml, /robots.txt, /logo.svg, /icon.png.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Exact localized routes -> their generated shell (internal, URL unchanged).
  #    Anchored with $ so /en/projects/some-slug does NOT match /en/projects.
  RewriteRule ^(en|ar-eg|ar-sa)/?$                                              __seo/$1/index.html [L]
  RewriteRule ^(en|ar-eg|ar-sa)/(about|services|projects|process|contact|privacy|terms)/?$  __seo/$1/$2.html [L]

  #    Solution landing pages live one level deeper, so they need their own
  #    anchored rule. The shell filenames are flat (solutions-<slug>.html), so
  #    the nested public URL maps to a hyphenated file. One exact rule per page,
  #    anchored with $: nothing else under /solutions/ can match.
  RewriteRule ^(en|ar-eg|ar-sa)/solutions/custom-business-systems/?$  __seo/$1/solutions-custom-business-systems.html [L]
  RewriteRule ^(en|ar-eg|ar-sa)/solutions/real-estate-systems/?$  __seo/$1/solutions-real-estate-systems.html [L]

  # 5. Locale-less application routes -> the market router, which reads the
  #    original path from REQUEST_URI and 302s to the same page in the chosen
  #    market. Internal rewrite, so /market-router.php never appears in the
  #    browser. Fragments are client-side and never reach the server.
  RewriteRule ^(about|services|projects|process|contact|privacy|terms)(/.*)?$ market-router.php [L,QSA]

  #    Locale-less solution URLs take the same path. Listed one page at a time
  #    on purpose: /solutions/* is NOT claimed wholesale, so an unbuilt slug
  #    falls through to the SPA and renders the 404 route instead of 302ing to
  #    a page that does not exist. QSA keeps gclid/UTM intact through the 302,
  #    which is what makes paid landing traffic measurable.
  RewriteRule ^solutions/custom-business-systems/?$ market-router.php [L,QSA]
  RewriteRule ^solutions/real-estate-systems/?$ market-router.php [L,QSA]

  # 6. Everything else (incl. /en/projects/:slug) -> the SPA shell.
  RewriteRule ^ index.html [L]
</IfModule>

# ===== Baseline browser security headers =====
#
# Guarded: if mod_headers is ever unavailable the site must keep serving, unlike
# the GeoIP directive above (which is proven on this host and must stay bare so
# a missing module fails loudly rather than silently routing everyone to /en).
#
# Deliberately NOT here: COOP/COEP/CORP (they can break third-party integrations
# for no benefit at this baseline). That is its own issue.
#
# Content-Security-Policy IS here now, but only in report-only form. See the
# canary block at the end of this section.
<IfModule mod_headers.c>
  # Stop browsers from MIME-sniffing a response into a different type — the
  # classic route from "uploaded text file" to "executed script".
  Header always set X-Content-Type-Options "nosniff"

  # Same-origin navigations keep the full referrer (useful for internal
  # analytics); cross-origin requests get the origin only, and HTTPS->HTTP
  # sends nothing. Good privacy without breaking referral attribution.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Nothing in the site is designed to be embedded by another origin (audited:
  # no iframes, no postMessage, no embed partners), so refuse external framing.
  # SAMEORIGIN rather than DENY keeps same-origin framing available if a future
  # internal tool needs it. CSP frame-ancestors is a separate issue.
  Header always set X-Frame-Options "SAMEORIGIN"

  # The site never asks for location, camera or microphone, so deny them
  # outright — including for anything it might embed. Other features are left
  # unset on purpose: restricting APIs the code does not use buys nothing and
  # risks blocking a legitimate future feature.
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"

  # Explicitly OFF, not on. The legacy XSS auditor is absent from modern
  # browsers and, where it survives, its filtering has itself been a source of
  # vulnerabilities. 0 disables it; 1;mode=block would re-enable that risk.
  Header always set X-XSS-Protection "0"

  # HSTS canary — 5 minutes only.
  # Do not add includeSubDomains: known Oraixen subdomains are not all
  # HTTPS-safe yet. Do not add preload.
  #
  # Audit evidence (Issue 16): ftp.oraixen.com does not currently provide usable
  # HTTPS, and autodiscover.oraixen.com presents a non-matching certificate while
  # serving plain HTTP today. The Let's Encrypt certificate covers only oraixen.com
  # and www.oraixen.com. includeSubDomains would therefore make known subdomains
  # unreachable for HSTS-aware browsers. Keep max-age at 300s until production
  # verification succeeds.
  Header always set Strict-Transport-Security "max-age=300" "expr=%{HTTPS} == 'on'"

  # Hostinger's PHP currently advertises its exact version (x-powered-by:
  # PHP/8.4.21) on every PHP response. Removing it costs nothing and gives
  # version-specific exploit scanning one less hint. `unset` on a header that
  # is not present is a no-op, so this is safe everywhere.
  Header always unset X-Powered-By

  # ===== Content-Security-Policy — REPORT-ONLY CANARY (Issue 23A) =====
  #
  # Report-Only, deliberately. The browser evaluates the whole policy and logs
  # every violation, but blocks nothing, so a mistake here costs a console
  # message rather than a broken page. Issue 23B promotes this same policy to
  # the enforcing `Content-Security-Policy` header once production traffic has
  # proven it silent. There is no violation-collection endpoint and none is
  # invented: verification is the browser console plus Tag Assistant.
  #
  # Written as ONE physical line on purpose. Apache 2.4 accepts backslash line
  # continuation, but this host serves .htaccess through LiteSpeed, and a policy
  # that silently lost half its directives to a parser difference would be worse
  # than an unreadable line. The reasoning lives in this comment instead.
  #
  # Every source below is backed by built output, not by source assumptions:
  #
  #   default-src 'self'      Anything not named below is same-origin only.
  #   base-uri 'self'         No <base> element exists in any of the 31 built
  #                           HTML files; this stops an injected one from
  #                           re-pointing every relative URL in the SPA.
  #   object-src 'none'       No <object>, <embed> or applet anywhere.
  #   frame-src 'none'        No iframes: audited across src/, index.html and
  #                           all 31 built shells.
  #   frame-ancestors 'self'  Deliberately matches X-Frame-Options SAMEORIGIN
  #                           above, so the modern and legacy headers agree.
  #   form-action 'self'      The contact form submits through fetch() to
  #                           /contact.php. Nothing posts off-origin.
  #   worker-src 'none'       dist/assets/*.js contains zero `new Worker` and no
  #                           service worker registration.
  #   manifest-src 'self'     /site.webmanifest.
  #   script-src / -elem      'self' is the Vite module bundle. The three sha256
  #                           hashes are the three inline application/ld+json
  #                           blocks (Organization, WebSite, ProfessionalService),
  #                           byte-identical in all 31 shells and computed from
  #                           the built output. googletagmanager.com is gtag.js,
  #                           appended only after an analytics grant
  #                           (src/lib/consent.ts). No 'unsafe-inline', no
  #                           'unsafe-eval': the bundle contains neither eval nor
  #                           new Function.
  #   script-src-attr 'none'  Zero inline event-handler attributes remain in the
  #                           built HTML. This is why the Google Fonts media-swap
  #                           trick was removed from index.html.
  #   style-src-elem          The built stylesheet plus the two Google Fonts
  #                           stylesheets: Aleo/Plus Jakarta linked from
  #                           index.html, and Tajawal injected for RTL markets by
  #                           src/i18n/index.ts. No inline <style> element exists
  #                           in the build, so none is allowed.
  #   style-src-attr          React style props compile to real inline style
  #                           attributes (13 source files) and cannot be hashed,
  #                           so 'unsafe-inline' is unavoidable here. It is
  #                           scoped to ATTRIBUTES only; script never gets it.
  #   style-src               Fallback for browsers that lack the granular
  #                           -elem/-attr directives, which is why it has to
  #                           carry the attribute allowance too.
  #   font-src                fonts.gstatic.com serves the faces those Google
  #                           stylesheets reference. 'self' is the same-origin
  #                           baseline; no face is self-hosted today.
  #   img-src                 'self'; data: for the inline SVG grain texture in
  #                           src/components/visual/GrainOverlay.tsx; unsplash
  #                           for the About hero and the project-card fallback;
  #                           then the twelve hosts that actually appear in the
  #                           imageUrl fields of src/data/projects*.json. Issue 32
  #                           rebuilds that data — self-hosting those twelve
  #                           images would collapse this list to 'self' data:.
  #                           The Google hosts are GA4 image beacons.
  #   connect-src             'self' covers /contact.php and /market-context.php.
  #                           The Google hosts are GA4 measurement; the wildcards
  #                           are required because GA4 shards collection across
  #                           regionN.google-analytics.com.
  #
  # upgrade-insecure-requests is deliberately NOT in this policy. Chrome ignores
  # the directive in a report-only policy and logs that it is ignoring it on
  # every page load — which is the one thing a canary must not do, because a
  # warning that is always present is a warning nobody reads. Production
  # verification found it as the single console entry with consent both
  # rejected and accepted. Hostinger already sends its own enforcing
  # `Content-Security-Policy: upgrade-insecure-requests` on the same response,
  # so leaving it out here changes no HTTPS-upgrade behaviour. Whether the
  # enforcing application policy should carry it is Issue 23B's decision.
  #
  # Google Ads endpoints (doubleclick.net, googleadservices.com,
  # googlesyndication.com) are intentionally ABSENT: no Google Ads tag is
  # configured on this site. Issue 20C must revisit this policy if Ads
  # conversion tracking is connected. Do not pre-open it before then.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'self'; form-action 'self'; worker-src 'none'; manifest-src 'self'; script-src 'self' 'sha256-4a9hKwKBRIE++p4GJpcSHCCt/sfxLyM7F9wYU0kIx4w=' 'sha256-zbQYvYkpG90D+jTAHRF+xdwfg+hifZYq56PagPZw6Qg=' 'sha256-mnRgAQWhjZQMqex8/ZHckZTAaw7SWQH8PufEIx/M+K0=' https://www.googletagmanager.com; script-src-elem 'self' 'sha256-4a9hKwKBRIE++p4GJpcSHCCt/sfxLyM7F9wYU0kIx4w=' 'sha256-zbQYvYkpG90D+jTAHRF+xdwfg+hifZYq56PagPZw6Qg=' 'sha256-mnRgAQWhjZQMqex8/ZHckZTAaw7SWQH8PufEIx/M+K0=' https://www.googletagmanager.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src-elem 'self' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://images.unsplash.com https://duvdu.com https://emydiscount.com https://gefires.com https://ibdl.net https://inovara.net https://is1-ssl.mzstatic.com https://maat.vip https://orderfs.com https://play-lh.googleusercontent.com https://saharadvocates.ae https://shopisonic.com https://vending.inovara.net https://www.googletagmanager.com https://*.google-analytics.com; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com"
</IfModule>

# Long-cache the fingerprinted build assets (filenames change every build).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
